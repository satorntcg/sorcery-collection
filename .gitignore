# Dependencies
node_modules/

# Production build
dist/

# Local environment and secrets
.env
.env.*
!.env.example
# **/.temp/ (not just supabase/.temp/) so an accidental nested
# `supabase/supabase/.temp/` from running the CLI in the wrong
# directory is caught too, not just the top-level one.
**/.temp/
supabase/supabase/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode/*.code-snippets
.vscode/launch.json
.idea/
